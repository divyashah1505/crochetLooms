            "url": {
              "raw": "{{baseUrl}}/products?tag=flower,purse&sort=newest&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "tag", "value": "flower,purse", "description": "Filter by tags like flower, purse" },
                { "key": "category", "value": "bags-purses", "disabled": true },
                { "key": "search", "value": "daisy", "disabled": true },
                { "key": "minPrice", "value": "500", "disabled": true },
