{
  "info": {
    "_postman_id": "crochet-api-collection-2026",
    "name": "Crochet E-Commerce REST API",
    "description": "Comprehensive Postman Collection for Artisan Crochet E-Commerce API replacing Swagger. Features automated auth tokens, Tag Master filtering, Google Auth, Cart, Orders, and Razorpay payment lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"admin_token\", jsonData.data.accessToken);",
                  "    console.log(\"Saved admin_token to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@crochet.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "login"]
            },
            "description": "Authenticate Admin and automatically save accessToken into {{admin_token}} environment variable."
          }
        }
      ]
    },
